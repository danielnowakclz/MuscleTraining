<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- NAME -->
        <TextView
            android:text="Name des Muskels"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edit_name"
            android:hint="z. B. Pectoralis Major"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/edittext_rounded"
            android:textSize="16sp"
            android:layout_marginTop="6dp"/>

        <!-- KATEGORIE -->
        <TextView
            android:text="Kategorie"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_rounded"
            android:padding="8dp" />

        <!-- POSITION AUF DEM KÖRPER -->
        <TextView
            android:text="Position auf dem Körper"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- FRONT / BACK SWITCH -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_front"
                android:text="Vorderseite"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btn_back"
                android:text="Rückseite"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"/>
        </LinearLayout>

        <!-- BODY VIEW -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="500dp"
            android:padding="0dp">

            <de.daniel_nowak.muscletraining.ui.MuscleBodyView
                android:id="@+id/view_body"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>


        <!-- ÜBUNGEN -->
        <TextView
            android:text="Zugehörige Übungen"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edit_search_ex"
            android:hint="Übungen suchen..."
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/edittext_rounded"
            android:textSize="16sp"
            android:layout_marginTop="6dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_exercises"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="12dp"/>

        <!-- BUTTONS -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btn_delete"
                android:text="Löschen"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                style="@style/PlusMinusButton.Rounded.Danger" />

            <Space
                android:layout_width="16dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btn_save"
                android:text="Speichern"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                style="@style/PlusMinusButton.Rounded" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_cancel"
            android:text="Abbrechen"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            style="@style/PlusMinusButton.Rounded.Secondary" />

    </LinearLayout>
</ScrollView>
