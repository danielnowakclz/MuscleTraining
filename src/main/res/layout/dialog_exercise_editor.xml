<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Name -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <TextView
                android:text="Name der Übung"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/edit_name"
                android:hint="z. B. Bankdrücken"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="@drawable/edittext_rounded"
                android:textSize="16sp"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Sätze (von – bis) -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <TextView
                android:text="Sätze (von – bis)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Min -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/edit_sets_min"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:inputType="number"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Min"/>

                <Button
                    android:id="@+id/btn_sets_min_minus"
                    style="@style/PlusMinusButton.Rounded.Secondary"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:layout_marginStart="8dp"/>

                <Button
                    android:id="@+id/btn_sets_min_plus"
                    style="@style/PlusMinusButton.Rounded"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Max -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/edit_sets_max"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:inputType="number"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Max"/>

                <Button
                    android:id="@+id/btn_sets_max_minus"
                    style="@style/PlusMinusButton.Rounded.Secondary"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:layout_marginStart="8dp"/>

                <Button
                    android:id="@+id/btn_sets_max_plus"
                    style="@style/PlusMinusButton.Rounded"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Wiederholungen -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <TextView
                android:text="Wiederholungen (von – bis – Schritt)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Min -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/edit_reps_min"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:inputType="number"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Min"/>

                <Button
                    android:id="@+id/btn_reps_min_minus"
                    style="@style/PlusMinusButton.Rounded.Secondary"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:layout_marginStart="8dp"/>

                <Button
                    android:id="@+id/btn_reps_min_plus"
                    style="@style/PlusMinusButton.Rounded"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Max -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/edit_reps_max"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:inputType="number"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Max"/>

                <Button
                    android:id="@+id/btn_reps_max_minus"
                    style="@style/PlusMinusButton.Rounded.Secondary"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:layout_marginStart="8dp"/>

                <Button
                    android:id="@+id/btn_reps_max_plus"
                    style="@style/PlusMinusButton.Rounded"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Step -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/edit_reps_step"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:inputType="number"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Schritt"/>

                <Button
                    android:id="@+id/btn_reps_step_minus"
                    style="@style/PlusMinusButton.Rounded.Secondary"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:layout_marginStart="8dp"/>

                <Button
                    android:id="@+id/btn_reps_step_plus"
                    style="@style/PlusMinusButton.Rounded"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Gewichte -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <TextView
                android:text="Gewichte (von – bis – Schritt)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Min -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/edit_min_weight"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Min"/>

                <Button
                    android:id="@+id/btn_min_weight_minus"
                    style="@style/PlusMinusButton.Rounded.Secondary"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:layout_marginStart="8dp"/>

                <Button
                    android:id="@+id/btn_min_weight_plus"
                    style="@style/PlusMinusButton.Rounded"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Max -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/edit_max_weight"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Max"/>

                <Button
                    android:id="@+id/btn_max_weight_minus"
                    style="@style/PlusMinusButton.Rounded.Secondary"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:layout_marginStart="8dp"/>

                <Button
                    android:id="@+id/btn_max_weight_plus"
                    style="@style/PlusMinusButton.Rounded"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Step -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/edit_weight_step"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Schritt"/>

                <Button
                    android:id="@+id/btn_weight_step_minus"
                    style="@style/PlusMinusButton.Rounded.Secondary"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:layout_marginStart="8dp"/>

                <Button
                    android:id="@+id/btn_weight_step_plus"
                    style="@style/PlusMinusButton.Rounded"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Muskel-Suche -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <TextView
                android:text="Muskeln suchen"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/edit_search"
                android:hint="z. B. Brust, Rücken..."
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="@drawable/edittext_rounded"
                android:textSize="16sp"
                android:layout_marginTop="6dp"/>
        </LinearLayout>


        <!-- Muskel-Liste -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_muscles"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="8dp"/>

        <!-- ===================== -->
        <!-- BUTTONS (Option A) -->
        <!-- ===================== -->

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <!-- Löschen (rot, links) -->
            <Button
                android:id="@+id/btn_delete"
                android:text="Löschen"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                style="@style/PlusMinusButton.Rounded.Danger" />

            <Space
                android:layout_width="16dp"
                android:layout_height="wrap_content" />

            <!-- Speichern (Material3‑Style) -->
            <Button
                android:id="@+id/btn_save"
                android:text="Speichern"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                style="@style/PlusMinusButton.Rounded" />
        </LinearLayout>

        <!-- Abbrechen (volle Breite) -->
        <Button
            android:id="@+id/btn_cancel"
            android:text="Abbrechen"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            style="@style/PlusMinusButton.Rounded.Secondary" />



    </LinearLayout>
</ScrollView>
