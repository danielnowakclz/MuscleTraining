<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========================================================= -->
    <!--  PLUS / MINUS BUTTONS                                    -->
    <!-- ========================================================= -->

    <!-- PLUS = Primary (Rot) -->
    <style name="PlusMinusButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <!-- MINUS = Secondary (Charcoal) -->
    <style name="PlusMinusButton.Secondary">
        <item name="android:minWidth">48dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:backgroundTint">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <!-- PRESSED STATE (Neon-Gelb) -->
    <style name="PlusMinusButton.Pressed">
        <item name="android:backgroundTint">?attr/colorTertiary</item>
        <item name="android:textColor">?attr/colorOnTertiary</item>
    </style>


    <!-- ========================================================= -->
    <!--  EDITTEXT STYLES                                          -->
    <!-- ========================================================= -->

    <!-- Normaler Input -->
    <style name="TrainingInput">
        <item name="android:backgroundTint">?attr/colorSecondaryContainer</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurface</item>
        <item name="android:padding">8dp</item>
        <item name="android:textSize">16sp</item>

        <!-- Material3 Aktivierungsfarben -->
        <item name="android:colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorControlHighlight">?attr/colorPrimary</item>
    </style>

    <!-- Fehlerzustand -->
    <style name="TrainingInput.Error">
        <item name="android:backgroundTint">?attr/colorTertiary</item>
        <item name="android:textColor">?attr/colorOnTertiary</item>
        <item name="android:textColorHint">?attr/colorOnTertiary</item>
    </style>


    <!-- ========================================================= -->
    <!--  HINT TEXTS                                               -->
    <!-- ========================================================= -->

    <style name="TrainingHint">
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">#777777</item>
    </style>

    <style name="TrainingHint.Dark">
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">#BBBBBB</item>
    </style>


    <!-- ========================================================= -->
    <!--  OPTIONAL: CARD STYLE FÜR EINGABEBLOCK                    -->
    <!-- ========================================================= -->

    <style name="TrainingCard">
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:padding">16dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:layout_margin">16dp</item>
    </style>


    <!-- ========================================================= -->
    <!--  OPTIONAL: TOOLBAR STYLE                                  -->
    <!-- ========================================================= -->

    <style name="TrainingToolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="android:titleTextColor">?attr/colorOnPrimary</item>
        <item name="android:subtitleTextColor">?attr/colorOnPrimary</item>
    </style>

    <!-- Material3 Rounded Plus/Minus Buttons -->
    <style name="PlusMinusButton.Rounded">
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:gravity">center</item>
        <item name="android:backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:shape">rectangle</item>
        <item name="android:radius">28dp</item>
    </style>

    <style name="PlusMinusButton.Rounded.Secondary">
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:gravity">center</item>
        <item name="android:backgroundTint">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="android:radius">28dp</item>
    </style>

    <style name="TrainingSpinner">
        <item name="android:background">@drawable/bg_spinner_with_arrow</item>
        <item name="android:popupBackground">?attr/colorSurface</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="PlusMinusButton.Rounded.Danger">
        <item name="android:backgroundTint">#D32F2F</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:padding">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ToolbarSubtitleStyle" parent="@style/TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#CCFFFFFF</item>
    </style>


</resources>
